{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "run.v1.schema.json",
  "title": "Fission Run Status v1",
  "type": "object",
  "required": [
    "schema_version", "run_id", "status", "created_at",
    "updated_at", "variant_count"
  ],
  "properties": {
    "schema_version": {"const": "run/v1"},
    "run_id": {"type": "string", "pattern": "^fission-"},
    "status": {
      "enum": ["draft", "dry_run", "no_generate", "generated",
                "exported", "failed"]
    },
    "created_at": {"type": "integer"},
    "updated_at": {"type": "integer"},
    "summary": {"type": ["string", "null"]},
    "export_dir": {"type": ["string", "null"]},
    "export_manifest": {"type": ["string", "null"]},
    "variant_count": {"type": "integer", "minimum": 0},
    "notes": {"type": "string"}
  }
}
