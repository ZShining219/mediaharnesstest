# ============================================================
# AI 传媒工作流 - 环境变量配置
# 复制为 .env 并填写。所有密钥只存在本机，不要提交到 git。
# ============================================================

# ---------- MiniMax (视频生成 H3 / 语音 TTS / 声音克隆) ----------
# 视频生成默认走秘塔代理 (metaso.cn), key 为 mk- 开头
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://metaso.cn/api/minimax/v2
# 视频生成通道: metaso(只用秘塔, 不回退官方) | official(只用官方) | auto(秘塔优先,官方兜底)
# 官方直连需 MINIMAX_GROUP_ID(账户页可见) + 账号开通 H3 视频按量
MINIMAX_VIDEO_VIA=metaso
MINIMAX_GROUP_ID=
# 秘塔前面有 WAF；默认对齐 EOS(Node fetch) 的 UA，避免被当成脚本客户端断开
MINIMAX_USER_AGENT=node
# 秘塔提交走本机 Node sidecar(与 EOS 同一 fetch/undici 栈)；不可用时自动回退 httpx
METASO_SIDECAR_URL=http://127.0.0.1:8791
# 可选: 指定 node 路径；默认从 PATH / nvm / homebrew 查找
NODE_BIN=
# 秘塔代理只代理视频接口; TTS/声音克隆走官方站 (sk- key):
MINIMAX_API_KEY_OFFICIAL=
MINIMAX_BASE_URL_OFFICIAL=https://api.minimax.cn/v2
# 官方站请求需带 GroupId 参数(可为空值); 控制台"账户-基本信息"可见
MINIMAX_GROUP_ID=

# ---------- DeepSeek (LLM: 文案/提示词; 可选, 挂了自动降级) ----------
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# LLM 单次请求超时秒数
LLM_TIMEOUT_SECONDS=60
# B 线提示词粒度严格模式: 1=beat 粒度不足时拒绝编译(默认 0, 只记 lint 警告)
PV_PROMPT_LINT_STRICT=0

# ---------- 腾讯云 (MPS 媒体处理: 转码/智能字幕/封面等, 可选) ----------
# https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_MPS_REGION=ap-guangzhou

# ---------- WaveSpeed AI (托管生成模型, 国内直连, 按次计费) ----------
# https://wavespeed.ai 控制台创建 API key
# 承担: InfiniteTalk 口播数字人 / Wan2.2-Animate 换人 / Qwen-Image-Edit 换装
WAVESPEED_API_KEY=

# ---------- Pexels 素材库 (可选, 自动选材用) ----------
# https://www.pexels.com/api/ 免费申请, 200 次/时
# 不配则自动选材走 Wikimedia Commons(免 key, 质量参差)
PEXELS_API_KEY=

# ---------- ComfyUI ----------
# 本地: http://127.0.0.1:8188
# 云端 GPU (推荐, 视频模型需要 24-32G 显存): http://<云服务器IP>:8188
COMFYUI_BASE_URL=http://127.0.0.1:8188
# 若云端 ComfyUI 加了 Basic Auth / 反向代理 token
COMFYUI_AUTH=

# ---------- MoneyPrinterTurbo (自动化创作管线) ----------
# 本地默认 http://127.0.0.1:8080
MPT_BASE_URL=http://127.0.0.1:8080

# ---------- social-auto-upload (抖音等自动发布) ----------
# sau 可执行文件路径, setup.sh 安装后默认为服务目录下的 .venv/bin/sau
SAU_BIN=
# 默认发布账号名(sau douyin login --account <name> 时用的名字)
SAU_ACCOUNT=main

# ---------- 编排器 ----------
ORCH_HOST=127.0.0.1
ORCH_PORT=8800
# 审核页面是否需要密码 (可空)。若部署到云建议设置。
ORCH_TOKEN=
ASSETS_PW=    # 素材管理器(copyparty) admin 密码
